# ============ 数据库 ============
DATABASE_URL="mysql://root:password@localhost:3306/mindflow"

# ============ JWT ============
# JWT 密钥(生产环境务必更换为强随机字符串)
JWT_SECRET="mindflow-jwt-secret-change-me"
JWT_EXPIRES_IN="7d"

# ============ 服务端口 ============
PORT=3030

# ============ CORS ============
# 前端开发地址
CLIENT_ORIGIN="http://localhost:3031"

# ============ 向量数据库 Qdrant ============
# Docker 启动: docker run -p 6333:6333 -p 6334:6334 qdrant/qdrant
QDRANT_URL="http://127.0.0.1:6333"
# 若开启鉴权则填写, 默认 docker 启动时留空即可
QDRANT_API_KEY=""
# 向量维度 — bge-m3 dense 向量为 1024 维
QDRANT_VECTOR_SIZE=1024

# ============ Embedding 服务 ============
# 兼容 OpenAI /v1/embeddings 接口, 支持本地 Ollama / 阿里云 DashScope 等
# 本地 Ollama bge-m3: 端点 http://127.0.0.1:11434/v1, 无需 API Key
# 注意: 模型名需与 `ollama list` 输出的 NAME 完全一致(含命名空间), 否则报 404 model not found
# 阿里云 DashScope: 端点 https://dashscope.aliyuncs.com/compatible-mode/v1, 需填写 API Key
EMBEDDING_BASE_URL="http://127.0.0.1:11434/v1"
# API Key (本地 Ollama 留空即可; DashScope 填写 DASHSCOPE_API_KEY)
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="qllama/bge-m3:latest"
EMBEDDING_DIMENSION=1024

# ============ 本地文件存储 ============
# 上传文件保存根目录 (相对于 server/ 目录)
UPLOAD_DIR="uploads"
# 单文件最大字节数 (150MB)
UPLOAD_MAX_FILE_BYTES=157286400

# ============ LLM 服务: DeepSeek ============
# 知识问答 RAG 流程中调用 DeepSeek API 生成回答
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-flash"
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_MAX_TOKENS=4096
